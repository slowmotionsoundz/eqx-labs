rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user's email exists in the admins collection
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
        request.auth.token.email == "eqlabseu@gmail.com" ||
        request.auth.token.email == "slowmotion767@gmail.com" ||
        request.auth.token.email == "slowmotionsoundzeurope@gmail.com"
      );
    }

    // Helper function to check if the user is the Super Admin
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == "slowmotion767@gmail.com";
    }

    // Rules for the admins collection
    match /admins/{email} {
      // Anyone authenticated can read the admins list
      allow read: if isAuthenticated();
      // Only the Super Admin can create, update, or delete admin records
      allow write: if isSuperAdmin();
    }

    // Rules for all other collections (CRM data)
    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }
    match /tasks/{taskId} {
      allow read, write: if isAdmin();
    }
    match /alerts/{alertId} {
      allow read, write: if isAdmin();
    }
    match /leads/{leadId} {
      allow read, write: if isAdmin();
    }
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }
  }
}
